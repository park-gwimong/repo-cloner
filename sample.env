# Copy to .env beside your repositories.json and fill in the providers you use.
# Existing process environment variables take precedence over .env values.
# Names follow <PROVIDER>_TOKEN / <PROVIDER>_EMAIL; see tokenEnv / usernameEnv.

# GitHub / GitHub Enterprise personal access token
GITHUB_TOKEN=

# Bitbucket Cloud account email and API token
BITBUCKET_CLOUD_EMAIL=
BITBUCKET_CLOUD_TOKEN=

# Bitbucket Server / Data Center personal access token
BITBUCKET_SERVER_TOKEN=
