{
  "credentials": "./repositories.json",
  "destination": "./clones",
  "protocol": "ssh",
  "sources": [
    {
      "name": "관제 시스템",
      "provider": "bitbucket-cloud",
      "workspace": "YOUR_WORKSPACE",
      "project": "PROJECT_KEY",
      "include": ["api", "web"]
    },
    {
      "name": "YOUR_ORGANIZATION",
      "provider": "github",
      "organization": "YOUR_ORGANIZATION",
      "credentials": "./github.json"
    }
  ]
}
