{
  "credentials": "./repositories.json",
  "destination": "./clones",
  "protocol": "ssh",
  "sources": [
    {
      "name": "my-org",
      "provider": "github",
      "organization": "YOUR_ORGANIZATION",
      "skipArchived": true,
      "skipForks": true,
      "include": [
        "api-*",
        "web-*"
      ],
      "exclude": [
        "*-archive"
      ]
    }
  ]
}
