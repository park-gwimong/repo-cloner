{
  "destination": "./clones",
  "protocol": "ssh",
  "layout": "source",
  "submodules": false,
  "sources": [
    {
      "name": "github-my-team",
      "provider": "github",
      "organization": "YOUR_ORGANIZATION",
      "credentials": "./github.json",
      "skipArchived": true,
      "skipForks": true,
      "include": [],
      "exclude": [
        "*-archive"
      ]
    },
    {
      "name": "bitbucket-projects",
      "provider": "bitbucket-cloud",
      "workspace": "YOUR_WORKSPACE",
      "projects": [
        "PROJECT_A",
        "PROJECT_B"
      ],
      "credentials": "./bitbucket-cloud.json",
      "submodules": true
    },
    {
      "name": "company-project-b",
      "provider": "bitbucket-server",
      "baseUrl": "https://bitbucket.example.com",
      "project": "PROJECT_KEY",
      "credentials": "./bitbucket-server.json"
    },
    {
      "name": "personal",
      "provider": "git",
      "repositories": [
        {
          "name": "repo-cloner",
          "url": "https://github.com/park-gwimong/repo-cloner.git"
        }
      ]
    }
  ]
}
